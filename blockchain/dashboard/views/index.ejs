<%- include('partials/header') %>

<div class="container-fluid mt-4">
    <!-- Section des statistiques -->
    <div class="row mb-4">
        <div class="col-md-4">
            <div class="card">
                <div class="card-header">
                    Statistiques Générales
                </div>
                <div class="card-body">
                    <div id="stats">
                        <p>Hash: <span id="totalHashesCount">0</span> (<span id="hashesPerHour">0</span>/h)</p>
                        <p>Encrypted: <span id="totalEncryptedCount">0</span> (<span id="encryptedPerHour">0</span>/h)</p>
                        <p>Messages: <span id="totalMessagesCount">0</span> (<span id="messagesPerHour">0</span>/h)</p>
                    </div>
                </div>
            </div>
        </div>
        
        <div class="col-md-4">
            <div class="card">
                <div class="card-header">
                    Performances Système
                </div>
                <div class="card-body">
                    <div id="systemStats">
                        <div class="d-flex align-items-center mb-2">
                            <div class="me-2">CPU:</div>
                            <div class="progress flex-grow-1">
                                <div id="cpuStatus" class="progress-bar" role="progressbar" style="width: 0%"></div>
                            </div>
                            <div class="ms-2"><span id="cpuValue">0%</span></div>
                        </div>
                        <div class="d-flex align-items-center mb-2">
                            <div class="me-2">Mémoire:</div>
                            <div class="progress flex-grow-1">
                                <div id="memoryStatus" class="progress-bar" role="progressbar" style="width: 0%"></div>
                            </div>
                            <div class="ms-2"><span id="memoryValue">0%</span></div>
                        </div>
                        <div class="d-flex align-items-center">
                            <div class="me-2">Disque:</div>
                            <div class="progress flex-grow-1">
                                <div id="diskStatus" class="progress-bar" role="progressbar" style="width: 0%"></div>
                            </div>
                            <div class="ms-2"><span id="diskValue">0%</span></div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-md-4">
            <div class="card">
                <div class="card-header">
                    Alertes
                </div>
                <div class="card-body">
                    <div id="alerts">
                        <div class="table-responsive">
                            <table class="table table-sm">
                                <thead>
                                    <tr>
                                        <th>Date</th>
                                        <th>Fichier</th>
                                        <th>Statut</th>
                                    </tr>
                                </thead>
                                <tbody id="alertsTableBody">
                                    <!-- Les alertes seront injectées ici via JavaScript -->
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Section des derniers messages -->
    <div class="row">
        <div class="col-md-4">
            <div class="card">
                <div class="card-header">
                    Derniers Hash
                </div>
                <div class="card-body">
                    <div class="table-responsive">
                        <table class="table table-sm">
                            <thead>
                                <tr>
                                    <th>Fichier</th>
                                    <th>Hash</th>
                                    <th>Temps</th>
                                </tr>
                            </thead>
                            <tbody id="recentHashTableBody"></tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-md-4">
            <div class="card">
                <div class="card-header">
                    Derniers Encrypted
                </div>
                <div class="card-body">
                    <div class="table-responsive">
                        <table class="table table-sm">
                            <thead>
                                <tr>
                                    <th>Fichier</th>
                                    <th>Status</th>
                                    <th>Temps</th>
                                </tr>
                            </thead>
                            <tbody id="recentEncryptedTableBody"></tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-md-4">
            <div class="card">
                <div class="card-header">
                    Derniers Messages
                </div>
                <div class="card-body">
                    <div class="table-responsive">
                        <table class="table table-sm">
                            <thead>
                                <tr>
                                    <th>Type</th>
                                    <th>Message</th>
                                    <th>Temps</th>
                                </tr>
                            </thead>
                            <tbody id="recentMessagesTableBody"></tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<%- include('partials/footer') %> 