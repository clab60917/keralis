<%- include('partials/header') %>

<div class="container-fluid mt-4">
    <!-- Section des statistiques -->
    <div class="row mb-4">
        <div class="col-md-4">
            <div class="card">
                <div class="card-header">
                    Statistiques Générales
                </div>
                <div class="card-body">
                    <div id="stats">
                        <p>Hash: <span id="hashCount">0</span> (<span id="hashRate">0</span>/h)</p>
                        <p>Encrypted: <span id="encryptedCount">0</span> (<span id="encryptedRate">0</span>/h)</p>
                        <p>Messages: <span id="messagesCount">0</span> (<span id="messagesRate">0</span>/h)</p>
                        <p>Dernière mise à jour: <span id="lastUpdated">-</span></p>
                    </div>
                </div>
            </div>
        </div>
        
        <div class="col-md-4">
            <div class="card">
                <div class="card-header">
                    Performances Système
                </div>
                <div class="card-body">
                    <div id="systemStats">
                        <p>CPU: <span id="cpuUsage">0</span>%</p>
                        <p>Mémoire: <span id="memoryUsage">0</span>%</p>
                        <p>Temps de traitement Hash: <span id="hashProcessingTime">0</span>ms</p>
                        <p>Temps de traitement Encrypted: <span id="encryptedProcessingTime">0</span>ms</p>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-md-4">
            <div class="card">
                <div class="card-header">
                    Alertes
                </div>
                <div class="card-body">
                    <div id="alerts">
                        <div class="table-responsive">
                            <table class="table table-sm">
                                <thead>
                                    <tr>
                                        <th>Date</th>
                                        <th>Fichier</th>
                                        <th>Statut</th>
                                    </tr>
                                </thead>
                                <tbody id="alertsTableBody">
                                    <!-- Les alertes seront injectées ici via JavaScript -->
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Section des derniers messages -->
    <div class="row">
        <div class="col-md-4">
            <div class="card">
                <div class="card-header">
                    Derniers Hash
                </div>
                <div class="card-body">
                    <div class="table-responsive">
                        <table class="table table-sm">
                            <thead>
                                <tr>
                                    <th>Fichier</th>
                                    <th>Hash</th>
                                    <th>Temps</th>
                                </tr>
                            </thead>
                            <tbody id="recentHashTableBody"></tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-md-4">
            <div class="card">
                <div class="card-header">
                    Derniers Encrypted
                </div>
                <div class="card-body">
                    <div class="table-responsive">
                        <table class="table table-sm">
                            <thead>
                                <tr>
                                    <th>Fichier</th>
                                    <th>Status</th>
                                    <th>Temps</th>
                                </tr>
                            </thead>
                            <tbody id="recentEncryptedTableBody"></tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-md-4">
            <div class="card">
                <div class="card-header">
                    Derniers Messages
                </div>
                <div class="card-body">
                    <div class="table-responsive">
                        <table class="table table-sm">
                            <thead>
                                <tr>
                                    <th>Type</th>
                                    <th>Message</th>
                                    <th>Temps</th>
                                </tr>
                            </thead>
                            <tbody id="recentMessagesTableBody"></tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<%- include('partials/footer') %> 